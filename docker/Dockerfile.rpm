# Builder image for Fedora .rpm package
# Usage:
#   docker build -f docker/Dockerfile.rpm -t rocket-rpm-builder .
#   docker run --rm -v "$PWD/dist:/dist" rocket-rpm-builder
#
# The .rpm artefact will be placed in dist/ on the host.
# Name and revision come from the first stanza of packaging/deb/changelog.

FROM fedora:41

# ---- Build dependencies ----
RUN dnf install -y \
    gcc-c++ \
    cmake \
    make \
    rpm-build \
    rpmdevtools \
    pkgconfig \
    fcitx5-devel \
    qt6-qtbase-devel \
    qt6-qttools-devel \
    libevdev-devel \
    libxkbcommon-devel \
    gtest-devel \
    extra-cmake-modules \
    && dnf clean all

# Set up rpmbuild tree
RUN rpmdev-setuptree

COPY . /tmp/src/

# Package name and 1.0.0-<revision> are the Debian changelog stanza, so the
# .rpm filename matches the .deb (rocket-switcher-1.0.0-138.fc41...).
RUN set -eu; \
    line=$(grep -m1 -E '^[a-z0-9][a-z0-9.+-]* \(' /tmp/src/packaging/deb/changelog); \
    name=$(printf '%s\n' "$line" | awk '{print $1}'); \
    full=$(printf '%s\n' "$line" | sed -n 's/.*(\([^)]*\)).*/\1/p'); \
    upstream=$(printf '%s\n' "$full" | sed 's/-[0-9][0-9]*$//'); \
    revision=$(printf '%s\n' "$full" | sed 's/.*-//'); \
    test "$name" = "rocket-switcher"; \
    test -n "$upstream"; \
    test -n "$revision"; \
    mkdir -p "/tmp/${name}-${upstream}"; \
    tar -C /tmp/src --exclude=./.git -cf - . | tar -C "/tmp/${name}-${upstream}" -xf -; \
    tar czf "$HOME/rpmbuild/SOURCES/${name}-${upstream}.tar.gz" \
        -C /tmp "${name}-${upstream}"; \
    cp /tmp/src/packaging/rpm/rocket-switcher.spec \
       "$HOME/rpmbuild/SPECS/rocket-switcher.spec"; \
    rpmbuild -bb "$HOME/rpmbuild/SPECS/rocket-switcher.spec" \
        --define "deb_upstream ${upstream}" \
        --define "deb_revision ${revision}" \
        --define "_build_ncpus $(nproc)"

# Copy artefact to /dist
CMD mkdir -p /dist && \
    find ~/rpmbuild/RPMS -name "*.rpm" -exec cp {} /dist/ \; && \
    echo "Done: $(ls /dist/*.rpm)"
